# ==============================================================================
# Cinerush Global Environment Configuration Example
# Copy file nay thanh .env de cau hinh bien moi truong cho Docker va cac thanh phan.
# ==============================================================================

# 1. Database PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cinerush
SPRING_DATASOURCE_USERNAME=cinerush
SPRING_DATASOURCE_PASSWORD=password123
DB_PORT=5433

# 2. Redis Configuration
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# 3. Backend server Configuration
SERVER_PORT=8080

# 4. Frontend API Client base URL (Dung cho local development)
VITE_API_BASE_URL=http://localhost:8080
